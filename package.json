{
  "name": "music-tools",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test audiojoin/tests/wav-engine.test.cjs cashier/tests/audio-analysis.test.cjs shared/tests/i18n.test.cjs tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "build:desktop": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File audiojoin/desktop/build.ps1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.0",
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.56.0"
  }
}
